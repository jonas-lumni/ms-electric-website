# Environment variables (names only, never values). Copy to .env.local for development;
# in production set them in the hosting panel (Vercel: mark as "Sensitive"). See docs/SEGURANCA.md.
#
# Variables starting with NEXT_PUBLIC_ end up in the browser JavaScript: only public IDs there.

# Content-Security-Policy in report-only mode while testing new third-party scripts (1 = on)
CSP_REPORT_ONLY=

# --- Future: quote form phase (server-only, NEVER prefix with NEXT_PUBLIC_) ---
# GHL_PIT_TOKEN=
# GHL_LOCATION_ID=
# TURNSTILE_SECRET_KEY=
# EXPECTED_HOSTNAME=mandselectric.net

# --- Future: public IDs (safe in the browser) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GHL_BOOKING_URL=
